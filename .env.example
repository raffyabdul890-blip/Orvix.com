# Resend (https://resend.com) — used to email lead form submissions.
# Create an API key and verify a sending domain, then set:
RESEND_API_KEY=

# Verified "from" address for Resend (must be on a domain you've verified with Resend).
LEAD_FROM_EMAIL="Orvix Leads <leads@orvix.com>"

# Inbox that receives lead notifications. Never exposed to the frontend.
LEAD_TO_EMAIL=

# OpenRouter (https://openrouter.ai) — powers the AI chat widget.
# Create an API key at https://openrouter.ai/keys, then set:
OPENROUTER_API_KEY=

# Optional: override the default model (openai/gpt-4o-mini) with any
# OpenRouter model slug, e.g. anthropic/claude-3.5-haiku.
OPENROUTER_MODEL=
